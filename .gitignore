```gitignore
# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/

# Cache
.cache/
.parcel-cache/
.vite/
.tmp/
temp/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Local database files
*.sqlite
*.sqlite3
*.db

# Uploads and user-generated files
uploads/*
!uploads/.gitkeep

# Certificates and private keys
*.pem
*.key
*.crt

# Optional package manager files
# Keep package-lock.json, yarn.lock, and pnpm-lock.yaml tracked.

# Debug files
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
```
